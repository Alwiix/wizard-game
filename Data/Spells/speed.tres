[gd_resource type="Resource" script_class="SpellData" load_steps=4 format=3]

[ext_resource type="Script" path="res://statuses/combat_effect_data.gd" id="1_effect"]
[ext_resource type="Script" path="res://Scripts/Spells/spell_data.gd" id="2_spell"]

[sub_resource type="Resource" id="BonusDraw"]
script = ExtResource("1_effect")
effect_type = 1
amount = 1
status_id = &"bonus_draw"

[resource]
script = ExtResource("2_spell")
spell_id = &"speed"
display_name = "Speed"
description = "Draw 1 additional card next turn."
energy_cost = 2
effects = Array[ExtResource("1_effect")]([SubResource("BonusDraw")])
