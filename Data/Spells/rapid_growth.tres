[gd_resource type="Resource" script_class="SpellData" load_steps=5 format=3]

[ext_resource type="Script" path="res://statuses/combat_effect_data.gd" id="1_effect"]
[ext_resource type="Script" path="res://Scripts/Spells/spell_data.gd" id="2_spell"]

[sub_resource type="Resource" id="DoubleVines"]
script = ExtResource("1_effect")
effect_type = 7
target = 1
amount = 2
status_id = &"creeping_vines"

[sub_resource type="Resource" id="SeedVines"]
script = ExtResource("1_effect")
effect_type = 1
target = 1
amount = 1
status_id = &"creeping_vines"
condition_type = 2
condition_status_id = &"creeping_vines"

[resource]
script = ExtResource("2_spell")
spell_id = &"rapid_growth"
display_name = "Rapid Growth"
description = "Double the target's Creeping Vines. If it has none, apply 1 Creeping Vines."
energy_cost = 1
effects = Array[ExtResource("1_effect")]([SubResource("DoubleVines"), SubResource("SeedVines")])
