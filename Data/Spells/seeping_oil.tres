[gd_resource type="Resource" script_class="SpellData" load_steps=5 format=3]

[ext_resource type="Script" path="res://statuses/combat_effect_data.gd" id="1_effect"]
[ext_resource type="Script" path="res://Scripts/Spells/spell_data.gd" id="2_spell"]

[sub_resource type="Resource" id="ConvertVinesToOil"]
script = ExtResource("1_effect")
effect_type = 8
target = 4
amount = 3
status_id = &"creeping_vines"
converted_status_id = &"oil"

[sub_resource type="Resource" id="SeedVines"]
script = ExtResource("1_effect")
effect_type = 1
target = 4
amount = 1
status_id = &"creeping_vines"
condition_type = 3
condition_status_id = &"creeping_vines"

[resource]
script = ExtResource("2_spell")
spell_id = &"seeping_oil"
display_name = "Seeping Oil"
description = "Convert up to 3 Creeping Vines on each enemy into that much Oil. If no enemy has Creeping Vines, apply 1 Creeping Vines to every enemy instead."
energy_cost = 1
effects = Array[ExtResource("1_effect")]([SubResource("ConvertVinesToOil"), SubResource("SeedVines")])
